{
  "rewrites": [
    { "source": "/.well-known/oauth-authorization-server", "destination": "/api/well-known?type=auth" },
    { "source": "/.well-known/oauth-protected-resource", "destination": "/api/well-known?type=resource" },
    { "source": "/.well-known/oauth-protected-resource/api/mcp", "destination": "/api/well-known?type=resource" },
    { "source": "/((?!assets/|api/).*)", "destination": "/index.html" }
  ],
  "crons": [{ "path": "/api/calendly-sync", "schedule": "0 6 * * *" }],
  "functions": {
    "api/find-companies.ts": { "maxDuration": 60 }
  }
}
